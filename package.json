{
  "name": "redding-supper-club",
  "version": "1.0.0",
  "private": true,
  "description": "A thoughtfully hosted North State dinner. A simple HTML and Tailwind landing page.",
  "scripts": {
    "build": "tailwindcss -i ./styles.css -o ./assets/styles.css --minify && node build.mjs",
    "watch": "tailwindcss -i ./styles.css -o ./assets/styles.css --watch",
    "test": "node --test tests/*.test.mjs",
    "dev": "node dev.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
